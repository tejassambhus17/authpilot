{
  "name": "authpilot",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/run-with-node.mjs node_modules/next/dist/bin/next dev --webpack",
    "build": "node scripts/run-with-node.mjs node_modules/next/dist/bin/next build --webpack",
    "start": "node scripts/run-with-node.mjs node_modules/next/dist/bin/next start",
    "lint": "node scripts/run-with-node.mjs node_modules/eslint/bin/eslint.js .",
    "typecheck": "node scripts/run-with-node.mjs node_modules/typescript/bin/tsc --noEmit",
    "test": "node scripts/run-with-node.mjs node_modules/vitest/vitest.mjs run",
    "test:watch": "node scripts/run-with-node.mjs node_modules/vitest/vitest.mjs",
    "test:e2e": "node scripts/run-with-node.mjs node_modules/@playwright/test/cli.js test",
    "runtime": "node scripts/run-with-node.mjs --version",
    "test:quality": "node scripts/run-with-node.mjs node_modules/vitest/vitest.mjs run tests/research-quality.test.ts",
    "check:deployment": "node scripts/run-with-node.mjs --experimental-strip-types scripts/check-deployment.mjs",
    "check": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.2.8",
    "@libsql/client": "^0.15.15",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "lucide-react": "^0.577.0",
    "next": "^16.0.0",
    "next-themes": "^0.4.6",
    "openai": "^6.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "server-only": "^0.0.1",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@tailwindcss/postcss": "^4.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
