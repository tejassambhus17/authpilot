# Required only for live research; curated guides work without this.
OPENAI_API_KEY=
# Model must support Responses, hosted web_search, and structured output.
OPENAI_MODEL=gpt-5.5

# Optional as a pair locally. Both required for durable storage on Vercel.
# URL must be a public libsql:// or https:// endpoint, with no embedded credentials.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Optional shared gate locally; strongly recommended on a public deployment.
# If set, enter it in the research UI. Generate a long, random value.
# Do not put this or your OpenAI key in NEXT_PUBLIC_ variables.
RESEARCH_ACCESS_TOKEN=

# Avoid user-level telemetry config writes in restricted environments.
NEXT_TELEMETRY_DISABLED=1
