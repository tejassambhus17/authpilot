      "css": ".ds-button-primary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 15px;border-radius:7px;border:1px solid var(--border,#e3e8e0);background:var(--surface,#fff);color:var(--foreground,#1c2923);font-size:12px;font-weight:550;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s,transform .15s;background:var(--brand,#245c45);color:var(--canvas,#fafbf8);border-color:transparent;}.ds-button-primary:hover{background:var(--brand-hover,#194c37);}.ds-button-primary:focus-visible{outline:3px solid var(--brand,#245c45);outline-offset:4px;}.ds-button-primary:disabled{cursor:not-allowed;opacity:.55;}.ds-button-primary:active{transform:translateY(1px);}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
