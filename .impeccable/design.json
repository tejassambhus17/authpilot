  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Shipped shared button variant; minimum height is 44px.",
      "html": "<button type=\"button\" class=\"ds-button-primary\">Research</button>",
      "css": ".ds-button-primary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid var(--border,#272b36);border-radius:7px;background:var(--surface-soft,#191d28);color:var(--foreground,#f3f4f6);font-size:12px;font-weight:580;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out;}.ds-button-primary{background:var(--primary,#7c3aed);color:#fff;border-color:transparent;}.ds-button-primary:hover{background:var(--primary-hover,#8b4df1);border-color:transparent;}.ds-button-primary:focus-visible{outline:3px solid var(--brand,#a78bfa);outline-offset:4px;}.ds-button-primary:disabled{cursor:not-allowed;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none;}}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shipped shared button variant; minimum height is 44px.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Share</button>",
      "css": ".ds-button-secondary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid var(--border,#272b36);border-radius:7px;background:var(--surface-soft,#191d28);color:var(--foreground,#f3f4f6);font-size:12px;font-weight:580;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out;}.ds-button-secondary:hover{border-color:color-mix(in srgb,var(--muted,#a8afbd) 55%,var(--border,#272b36));background:color-mix(in srgb,var(--foreground,#f3f4f6) 5%,var(--surface-soft,#191d28));}.ds-button-secondary:focus-visible{outline:3px solid var(--brand,#a78bfa);outline-offset:4px;}.ds-button-secondary:disabled{cursor:not-allowed;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
    },
    {
      "name": "Ghost button",
      "kind": "button",
      "refersTo": "button-ghost",
      "description": "Shipped shared button variant; minimum height is 44px.",
      "html": "<button type=\"button\" class=\"ds-button-ghost\">Clear filters</button>",
      "css": ".ds-button-ghost{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 15px;border:1px solid var(--border,#272b36);border-radius:7px;background:var(--surface-soft,#191d28);color:var(--foreground,#f3f4f6);font-size:12px;font-weight:580;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s ease-out,border-color .15s ease-out;}.ds-button-ghost{background:transparent;border-color:transparent;color:var(--muted,#a8afbd);}.ds-button-ghost:hover{border-color:color-mix(in srgb,var(--muted,#a8afbd) 55%,var(--border,#272b36));background:color-mix(in srgb,var(--foreground,#f3f4f6) 5%,var(--surface-soft,#191d28));}.ds-button-ghost:focus-visible{outline:3px solid var(--brand,#a78bfa);outline-offset:4px;}.ds-button-ghost:disabled{cursor:not-allowed;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-ghost{transition:none;}}"
    },
    {
      "name": "Library search",
      "kind": "input",
      "refersTo": "search-field",
      "description": "Surface search field from the actual guide library.",
      "html": "<div class=\"ds-search\"><svg width=\"17\" height=\"17\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.34-4.34\"/></svg><input type=\"search\" aria-label=\"Search guides\" placeholder=\"Search guides…\"/></div>",
      "css": ".ds-search{font-family:\"DM Sans Variable\",sans-serif;display:flex;align-items:center;gap:9px;min-height:43px;padding:0 13px;border:1px solid var(--border,#272b36);border-radius:8px;background:var(--surface,#13161e);color:var(--muted,#a8afbd);width:min(360px,100%);}.ds-search:focus-within{outline:2px solid var(--brand,#a78bfa);outline-offset:3px;}.ds-search input{font-family:inherit;width:100%;min-width:0;border:0;outline:none;background:none;height:40px;font-size:12px;color:var(--foreground,#f3f4f6);caret-color:var(--brand,#a78bfa);}.ds-search input::placeholder{color:var(--muted,#a8afbd);}"
    },
    {
      "name": "Provider research field",
      "kind": "input",
      "refersTo": "research-input",
      "description": "Visible research label, canvas-ground input, and factual help.",
      "html": "<label class=\"ds-label\" for=\"ds-provider\">Which provider are you integrating?</label><div class=\"ds-research-input\"><input id=\"ds-provider\" placeholder=\"Provider name or website, e.g. Notion or notion.so\" maxlength=\"160\" autocomplete=\"off\" aria-describedby=\"ds-provider-help\"/></div><p class=\"ds-help\" id=\"ds-provider-help\">Public names and websites only. Never enter API keys, client secrets, or private account information.</p>",
      "css": ".ds-label{font-family:\"DM Sans Variable\",sans-serif;display:block;font-size:13px;font-weight:550;color:var(--foreground,#f3f4f6);margin-bottom:10px;}.ds-research-input{display:flex;align-items:center;gap:10px;background:var(--canvas,#0b0d12);border:1px solid var(--border,#272b36);border-radius:7px;padding:0 14px;}.ds-research-input:focus-within{outline:2px solid var(--brand,#a78bfa);outline-offset:3px;}.ds-research-input input{font-family:\"DM Sans Variable\",sans-serif;width:100%;min-width:0;min-height:44px;border:0;outline:none;background:none;color:var(--foreground,#f3f4f6);font-size:13px;caret-color:var(--brand,#a78bfa);}.ds-research-input input::placeholder{color:var(--muted,#a8afbd);}.ds-help{font-family:\"DM Sans Variable\",sans-serif;color:var(--muted,#a8afbd);font-size:11px;line-height:1.8;margin:10px 0 0;}"
    },
    {
      "name": "Top navigation",
      "kind": "nav",
      "refersTo": "navigation-item",
      "description": "Text-first navigation with a real route current-page indicator.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"/\" aria-current=\"page\">Explore</a><a href=\"/guides\">Guides</a><a href=\"/saved\">Saved</a><a href=\"/methodology\">How it works</a></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:18px;}.ds-nav a{font-family:\"DM Sans Variable\",sans-serif;position:relative;display:flex;align-items:center;justify-content:center;min-height:72px;padding:0 12px;font-size:13px;font-weight:520;color:var(--muted,#a8afbd);text-decoration:none;transition:color .15s ease-out;}.ds-nav a:hover,.ds-nav a[aria-current=\"page\"]{color:var(--foreground,#f3f4f6);}.ds-nav a[aria-current=\"page\"]::after{content:\"\";position:absolute;height:2px;bottom:-1px;left:9px;right:9px;background:var(--brand,#a78bfa);}.ds-nav a:focus-visible{outline:3px solid var(--brand,#a78bfa);outline-offset:4px;}@media(prefers-reduced-motion:reduce){.ds-nav a{transition:none;}}"
    },
    {
      "name": "Selected library view",
      "kind": "nav",
      "refersTo": "library-filter-active",
      "description": "A library-local filter link, separate from the global top navigation.",
      "html": "<nav aria-label=\"Library views\"><a class=\"ds-library-filter\" href=\"/guides\" aria-current=\"page\">All guides</a></nav>",
      "css": ".ds-library-filter{font-family:\"DM Sans Variable\",sans-serif;display:flex;gap:9px;align-items:center;min-height:43px;padding:10px 11px;color:var(--muted,#a8afbd);border-radius:7px;font-size:12px;text-decoration:none;}.ds-library-filter[aria-current=\"page\"]{background:var(--accent,#221b36);color:var(--foreground,#f3f4f6);}.ds-library-filter:hover{background:var(--surface-soft,#191d28);}.ds-library-filter:focus-visible{outline:3px solid var(--brand,#a78bfa);outline-offset:4px;}"
    },
    {
      "name": "Source-confirmed evidence",
      "kind": "chip",
      "refersTo": "evidence-confirmed",
      "description": "Noninteractive evidence label; adjacent claim citations carry the links.",
      "html": "<span class=\"ds-evidence\"><svg width=\"10\" height=\"10\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.7\" aria-hidden=\"true\"><path d=\"M12 22s8-4 8-11V5l-8-3-8 3v6c0 7 8 11 8 11Z\"/><path d=\"m9 12 2 2 4-4\"/></svg>Source confirmed</span>",
      "css": ".ds-evidence{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;gap:4px;width:max-content;max-width:100%;border-radius:5px;padding:3px 7px;background:var(--success-bg,#142b23);color:var(--success,#7bdda5);font-size:10px;line-height:1.7;}"
    },
    {
