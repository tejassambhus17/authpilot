      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Shared button variant from the workspace; minimum target height stays 44px.",
      "html": "<button type=\"button\" class=\"ds-button-secondary\">Copy link</button>",
      "css": ".ds-button-secondary{font-family:\"DM Sans Variable\",sans-serif;display:inline-flex;align-items:center;justify-content:center;gap:9px;min-height:44px;padding:10px 15px;border-radius:7px;border:1px solid var(--border,#e3e8e0);background:var(--surface,#fff);color:var(--foreground,#1c2923);font-size:12px;font-weight:550;line-height:1.5;white-space:nowrap;cursor:pointer;transition:background .15s,transform .15s;}.ds-button-secondary:hover{background:var(--surface-soft,#f3f5f0);}.ds-button-secondary:focus-visible{outline:3px solid var(--brand,#245c45);outline-offset:4px;}.ds-button-secondary:disabled{cursor:not-allowed;opacity:.55;}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none;}}"
